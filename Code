<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Happy Birthday Aleya</title>
  <style>
    :root {
      --bg-1: #fffafc;
      --bg-2: #ffeaf3;
      --bg-3: #ffd6eb;
      --pink-1: #fff0f7;
      --pink-2: #ffcce5;
      --pink-3: #ff8fc6;
      --pink-4: #ff4d9d;
      --rose: #ff3b74;
      --orange: #ff9a6b;
      --purple: #8f6fd8;
      --text: #5d3b5a;
      --shadow: rgba(255, 111, 177, 0.28);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: radial-gradient(circle at top, #ffffff 0%, var(--bg-1) 22%, var(--bg-2) 55%, var(--bg-3) 100%);
      color: var(--text);
      overflow-x: hidden;
    }

    body {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 100vh;
    }

    .sparkles, .hearts, .confetti {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }

    .sparkles span,
    .confetti span {
      position: absolute;
      display: block;
      border-radius: 50%;
      animation: floatUp linear infinite;
    }

    .sparkles span {
      width: 7px;
      height: 7px;
      background: rgba(255,255,255,0.95);
      box-shadow: 0 0 12px rgba(255,255,255,0.9);
    }

    .hearts span {
      position: absolute;
      font-size: 26px;
      opacity: 0.75;
      animation: heartFloat ease-in-out infinite;
    }

    .confetti span {
      width: 10px;
      height: 16px;
      border-radius: 3px;
      opacity: 0.9;
      animation: confettiFall linear forwards;
    }

    .card {
      position: relative;
      z-index: 2;
      width: min(92vw, 560px);
      background: rgba(255,255,255,0.55);
      border: 1px solid rgba(255,255,255,0.65);
      border-radius: 30px;
      padding: 38px 28px 28px;
      text-align: center;
      box-shadow:
        0 30px 80px rgba(255, 93, 168, 0.15),
        0 0 0 1px rgba(255,255,255,0.25) inset;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      animation: slideUp 1.1s ease-out both;
    }

    .badge {
      display: inline-block;
      padding: 9px 18px;
      margin-bottom: 20px;
      border-radius: 999px;
      background: linear-gradient(135deg, #fff0f7, #ffd8ee);
      color: var(--pink-4);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      box-shadow: 0 8px 20px rgba(255, 123, 177, 0.18);
    }

    .photo-frame {
      width: min(78%, 270px);
      height: 270px;
      margin: 0 auto 22px;
      border-radius: 50%;
      overflow: hidden;
      background: linear-gradient(135deg, #ffdfe9, #fff6fb);
      border: 4px solid rgba(255, 141, 190, 0.9);
      box-shadow:
        0 18px 34px rgba(255, 96, 150, 0.18),
        0 0 18px rgba(255, 148, 196, 0.24);
    }

    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    h1 {
      margin: 0;
      font-size: clamp(34px, 7vw, 62px);
      line-height: 1.08;
      color: var(--pink-4);
      text-shadow: 0 0 20px rgba(255, 109, 181, 0.28);
      animation: glow 2.5s ease-in-out infinite alternate;
    }

    .subtitle {
      margin: 18px auto 22px;
      max-width: 450px;
      font-size: 18px;
      line-height: 1.8;
      color: rgba(93, 59, 86, 0.9);
    }

    .message {
      margin: 0 auto 22px;
      max-width: 430px;
      padding: 16px 18px;
      border-radius: 18px;
      background: rgba(255,255,255,0.38);
      border: 1px solid rgba(255,255,255,0.7);
      font-size: 15px;
      line-height: 1.7;
      color: rgba(79, 50, 70, 0.92);
      box-shadow: 0 10px 20px rgba(255, 141, 190, 0.08);
    }

    .gift-btn {
      display: inline-block;
      text-decoration: none;
      padding: 17px 30px;
      border-radius: 999px;
      border: none;
      background: linear-gradient(135deg, var(--pink-4), var(--orange));
      color: white;
      font-size: 17px;
      font-weight: 700;
      box-shadow:
        0 12px 30px rgba(255, 96, 150, 0.35),
        0 0 20px rgba(255, 140, 190, 0.3);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
      animation: pulse 2.2s ease-in-out infinite;
      cursor: pointer;
    }

    .gift-btn:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow:
        0 18px 40px rgba(255, 96, 150, 0.42),
        0 0 24px rgba(255, 140, 190, 0.35);
    }

    .popup {
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgba(49, 21, 39, 0.38);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
      z-index: 999;
      padding: 20px;
    }

    .popup.show {
      opacity: 1;
      pointer-events: auto;
    }

    .popup-box {
      width: min(92vw, 460px);
      background: linear-gradient(135deg, rgba(255,255,255,0.93), rgba(255, 240, 246, 0.9));
      border: 1px solid rgba(255,255,255,0.7);
      border-radius: 26px;
      padding: 28px 24px 20px;
      text-align: center;
      box-shadow: 0 22px 60px rgba(112, 34, 74, 0.22);
      transform: translateY(25px) scale(0.97);
      transition: transform 0.35s ease;
    }

    .popup.show .popup-box {
      transform: translateY(0) scale(1);
    }

    .popup h2 {
      margin: 0 0 14px;
      font-size: clamp(28px, 6vw, 42px);
      color: var(--pink-4);
    }

    .popup p {
      margin: 0;
      font-size: 17px;
      line-height: 1.7;
      color: rgba(93, 59, 86, 0.95);
    }

    .popup .close-btn {
      margin-top: 18px;
      display: inline-block;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--pink-4), var(--purple));
      color: white;
      font-weight: 700;
      cursor: pointer;
    }

    @keyframes slideUp {
      0% {
        opacity: 0;
        transform: translateY(26px) scale(0.97);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes glow {
      0% {
        text-shadow: 0 0 10px rgba(255, 109, 181, 0.22);
      }
      100% {
        text-shadow:
          0 0 12px rgba(255, 109, 181, 0.45),
          0 0 24px rgba(255, 109, 181, 0.35),
          0 0 42px rgba(255, 109, 181, 0.18);
      }
    }

    @keyframes pulse {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 12px 30px rgba(255, 96, 150, 0.35);
      }
      50% {
        transform: scale(1.04);
        box-shadow: 0 18px 35px rgba(255, 96, 150, 0.5);
      }
    }

    @keyframes floatUp {
      0% {
        transform: translateY(110vh) scale(0.5);
        opacity: 0;
      }
      10% { opacity: 0.9; }
      100% {
        transform: translateY(-20vh) scale(1.2);
        opacity: 0;
      }
    }

    @keyframes heartFloat {
      0%, 100% {
        transform: translateY(0) rotate(0deg);
        opacity: 0.45;
      }
      50% {
        transform: translateY(-18px) rotate(12deg);
        opacity: 1;
      }
    }

    @keyframes confettiFall {
      0% {
        transform: translateY(-20vh) rotate(0deg);
        opacity: 1;
      }
      100% {
        transform: translateY(110vh) rotate(540deg);
        opacity: 0;
      }
    }

    @media (max-width: 520px) {
      .card {
        padding: 28px 18px 24px;
      }

      .photo-frame {
        width: min(78%, 220px);
        height: 220px;
      }

      .subtitle,
      .message {
        font-size: 16px;
      }

      .gift-btn {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="sparkles" aria-hidden="true"></div>
  <div class="hearts" aria-hidden="true"></div>
  <div class="confetti" aria-hidden="true"></div>

  <div class="card">
    <div class="badge">Birthday Surprise</div>

    <div class="photo-frame">
      <img src="aleya.jpg" alt="Aleya" />
    </div>

    <h1>Happy Birthday<br>Aleya 💗</h1>

    <p class="subtitle">
      Today is all about celebrating you ✨<br>
      A little surprise has been made especially for you 💕
    </p>

    <div class="message">
      You are the kind of happiness that turns ordinary days into beautiful memories.<br>
      May your year be full of love, laughter, peace, and dreams that come true. 🌸
    </div>

    <button class="gift-btn" type="button">🎁 Open Your Gift</button>
  </div>

  <div class="popup" id="giftPopup" aria-hidden="true">
    <div class="popup-box">
      <h2>For Aleya 💖</h2>
      <p>
        Happy birthday, beautiful soul. You deserve all the joy in the world, every kind smile,
        every soft moment, and every dream that finds its way to you. May your life keep shining,
        your heart stay warm, and your smile stay unforgettable. Keep being you — the magic is in you.
      </p>
      <a class="close-btn" href="#" aria-label="Close surprise">Close</a>
    </div>
  </div>

  <script>
    const sparkleContainer = document.querySelector('.sparkles');
    const heartContainer = document.querySelector('.hearts');
    const confettiContainer = document.querySelector('.confetti');
    const giftBtn = document.querySelector('.gift-btn');
    const popup = document.getElementById('giftPopup');
    const closeBtn = document.querySelector('.close-btn');

    for (let i = 0; i < 26; i++) {
      const dot = document.createElement('span');
      dot.style.left = `${Math.random() * 100}%`;
      dot.style.top = `${Math.random() * 100}%`;
      dot.style.animationDuration = `${6 + Math.random() * 8}s`;
      dot.style.animationDelay = `${Math.random() * 5}s`;
      sparkleContainer.appendChild(dot);
    }

    const hearts = ['💖', '💗', '💕', '💞', '💘'];
    for (let i = 0; i < 12; i++) {
      const heart = document.createElement('span');
      heart.textContent = hearts[i % hearts.length];
      heart.style.left = `${Math.random() * 100}%`;
      heart.style.top = `${Math.random() * 100}%`;
      heart.style.animationDuration = `${5 + Math.random() * 7}s`;
      heart.style.animationDelay = `${Math.random() * 3}s`;
      heart.style.fontSize = `${18 + Math.random() * 18}px`;
      heartContainer.appendChild(heart);
    }

    const confettiColors = ['#ff4d9d', '#ff8fc6', '#ffd166', '#8f6fd8', '#ff9a6b', '#7ec8c5'];
    for (let i = 0; i < 40; i++) {
      const piece = document.createElement('span');
      piece.style.left = `${Math.random() * 100}%`;
      piece.style.top = `${Math.random() * 20}%`;
      piece.style.background = confettiColors[Math.floor(Math.random() * confettiColors.length)];
      piece.style.animationDuration = `${4 + Math.random() * 5}s`;
      piece.style.animationDelay = `${Math.random() * 3}s`;
      piece.style.transform = `rotate(${Math.random() * 360}deg)`;
      confettiContainer.appendChild(piece);
    }

    giftBtn.addEventListener('click', () => {
      popup.classList.add('show');
      popup.setAttribute('aria-hidden', 'false');
    });

    closeBtn.addEventListener('click', (event) => {
      event.preventDefault();
      popup.classList.remove('show');
      popup.setAttribute('aria-hidden', 'true');
    });

    popup.addEventListener('click', (event) => {
      if (event.target === popup) {
        popup.classList.remove('show');
        popup.setAttribute('aria-hidden', 'true');
      }
    });
  </script>
</body>
</html>
